{
    "name": "andreybolonin/modernorm-bundle",
    "description": "Symfony integration and Profiler for ModernORM, the PostgreSQL-first ORM.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "andreybolonin/modernorm": "^0.1.0-beta.3",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^2.2",
        "doctrine/migrations": "^3.9",
        "friendsofphp/php-cs-fixer": "^3.90",
        "open-telemetry/api": "^1.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/web-profiler-bundle": "Displays ModernORM metrics in the Symfony toolbar and Profiler.",
        "symfony/twig-bundle": "Renders the ModernORM Profiler panel.",
        "doctrine/migrations": "Enables optional ModernORM migration commands.",
        "doctrine/data-fixtures": "Enables optional fixture loading.",
        "open-telemetry/api": "Records ModernORM operation metrics with the optional OpenTelemetry adapter; configure a MeterProvider in your application."
    },
    "autoload": {
        "psr-4": {
            "ModernORM\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModernORM\\Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress",
        "analyse:core": "@php vendor/bin/phpstan analyse --configuration=phpstan-core.neon.dist --memory-limit=1G --no-progress",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "quality": [
            "@analyse",
            "@cs:check"
        ]
    },
    "conflict": {
        "doctrine/migrations": "<3.9 || >=4.0",
        "doctrine/data-fixtures": "<2.2 || >=3.0"
    },
    "homepage": "https://github.com/andreybolonin/modernormbundle",
    "support": {
        "issues": "https://github.com/andreybolonin/modernormbundle/issues",
        "source": "https://github.com/andreybolonin/modernormbundle"
    },
    "keywords": [
        "symfony-bundle",
        "orm",
        "postgresql",
        "profiler",
        "migrations"
    ],
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.idea",
            "/.phpunit.cache",
            "/vendor",
            "/var",
            "/.env",
            "/.env.*",
            "/examples/observability/vendor",
            "/examples/observability/.runtime",
            "/.phpstan-cache",
            "/.php-cs-fixer.cache"
        ]
    }
}
