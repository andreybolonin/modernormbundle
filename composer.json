{
    "name": "andreybolonin/modernorm-bundle",
    "description": "Symfony integration and Profiler for ModernORM, the PostgreSQL-first ORM.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "andreybolonin/modernorm": "^0.1@beta",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "doctrine/migrations": "^3.9",
        "doctrine/data-fixtures": "^2.2"
    },
    "suggest": {
        "symfony/web-profiler-bundle": "Displays ModernORM metrics in the Symfony toolbar and Profiler.",
        "symfony/twig-bundle": "Renders the ModernORM Profiler panel.",
        "doctrine/migrations": "Enables optional ModernORM migration commands.",
        "doctrine/data-fixtures": "Enables optional fixture loading."
    },
    "autoload": {
        "psr-4": {
            "ModernORM\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModernORM\\Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "doctrine/migrations": "<3.9 || >=4.0",
        "doctrine/data-fixtures": "<2.2 || >=3.0"
    },
    "homepage": "https://github.com/andreybolonin/modernormbundle",
    "support": {
        "issues": "https://github.com/andreybolonin/modernormbundle/issues",
        "source": "https://github.com/andreybolonin/modernormbundle"
    },
    "keywords": [
        "symfony-bundle",
        "orm",
        "postgresql",
        "profiler",
        "migrations"
    ],
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.idea",
            "/.phpunit.cache",
            "/vendor",
            "/var",
            "/.env",
            "/.env.*"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/andreybolonin/modernorm"
        }
    ]
}
