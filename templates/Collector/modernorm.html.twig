{% extends '@WebProfiler/Profiler/layout.html.twig' %}
{% import '@ModernORM/Collector/_macros.html.twig' as ui %}

{% block stylesheets %}
    {{ parent() }}
    <style{% if csp_style_nonce is defined and csp_style_nonce %} nonce="{{ csp_style_nonce }}"{% endif %}>{{ include('@ModernORM/Collector/_styles.html.twig') }}</style>
{% endblock %}

{% block toolbar %}
    {% set icon %}<span class="sf-toolbar-value">M</span><span class="sf-toolbar-value">{{ collector.metrics.sql.count }}</span><span class="sf-toolbar-label">SQL</span>{% endset %}
    {% set text %}
        <div class="sf-toolbar-info-piece"><b>ModernORM</b><span>PostgreSQL</span></div>
        <div class="sf-toolbar-info-piece"><b>SQL time</b><span>{{ collector.metrics.sql.timeMs|number_format(2) }} ms</span></div>
        <div class="sf-toolbar-info-piece"><b>Flush / batch</b><span>{{ collector.metrics.flush.count }} / {{ collector.metrics.batch.count }}</span></div>
        <div class="sf-toolbar-info-piece"><b>L2 hits / misses</b><span>{{ collector.l2.hits }} / {{ collector.l2.misses }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Advisor findings</b><span>{{ collector.findings|length }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Statistics</b><span>{{ collector.enabled ? 'enabled' : 'disabled' }}</span></div>
    {% endset %}
    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: collector.errorCount > 0 ? 'red' : (collector.findings ? 'yellow' : 'normal')}) }}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.errorCount > 0 ? 'label-status-error' }}"><span class="icon">M</span><strong>ModernORM</strong><span class="count">{{ collector.metrics.sql.count }}</span></span>
{% endblock %}

{% block panel %}
    {% set tabs = {overview: 'Overview', queries: 'Queries', unitofwork: 'UnitOfWork', hydration: 'Hydration', batch: 'Batch Fetching', cache: 'L2 Cache', bulk: 'Bulk Operations', postgresql: 'PostgreSQL'} %}
    {% set active = app.request.query.get('modernorm_tab', 'overview') %}
    {% if active not in tabs|keys %}{% set active = 'overview' %}{% endif %}
    {% set metrics = collector.metrics %}
    {% set runtime = collector.runtime %}
    {% set profileLink = path('_profiler', {token: token, panel: 'modernorm'}) %}
    <div class="morm-profiler" data-modernorm-panel="{{ active }}">
        <header class="morm-heading">
            <div><h2>{{ ui.icon('database') }} ModernORM</h2><p>PostgreSQL persistence, fetching, caching and request diagnostics.</p></div>
            <div class="morm-meta"><span class="morm-badge">{{ runtime.environment }}</span><span class="morm-badge">{{ runtime.coreVersion }}</span></div>
        </header>
        {% if not collector.enabled %}<div class="morm-notice">Statistics are disabled. Enable <code>modernorm.statistics.enabled</code> and capture a new request.</div>{% endif %}
        <div class="morm-metrics" aria-label="Request summary">
            {{ ui.metric('SQL operations', metrics.sql.count, '', 'database', profileLink ~ '&modernorm_tab=queries') }}
            {{ ui.metric('SQL time', metrics.sql.timeMs|number_format(2), 'ms', 'clock', profileLink ~ '&modernorm_tab=queries') }}
            {{ ui.metric('L2 hit rate', collector.l2HitRate is null ? null : collector.l2HitRate|number_format(1), '%', 'layers', profileLink ~ '&modernorm_tab=cache') }}
            {{ ui.metric('Advisor findings', collector.findings|length, '', 'alert', profileLink ~ '#performance-advisor') }}
            {{ ui.metric('New hydrated entities', metrics.hydration is null ? null : metrics.hydration.entitiesCreated, '', 'rows', profileLink ~ '&modernorm_tab=hydration') }}
            {{ ui.metric('Batch loads', metrics.batch.count, '', 'layers', profileLink ~ '&modernorm_tab=batch') }}
            {{ ui.metric('Planned inserts · last write phase', metrics.unitOfWork.lastWrites.insertions ?? null, '', 'rows', profileLink ~ '&modernorm_tab=unitofwork') }}
            {{ ui.metric('Planned updates · last write phase', metrics.unitOfWork.lastWrites.updates ?? null, '', 'rows', profileLink ~ '&modernorm_tab=unitofwork') }}
            {{ ui.metric('Planned deletes · last write phase', metrics.unitOfWork.lastWrites.deletions ?? null, '', 'rows', profileLink ~ '&modernorm_tab=unitofwork') }}
            {{ ui.metric('Flushes', metrics.flush.count, '', 'activity', profileLink ~ '&modernorm_tab=unitofwork') }}
            {{ ui.metric('Flush time', metrics.flush.timeMs|number_format(2), 'ms', 'clock', profileLink ~ '&modernorm_tab=unitofwork') }}
            {{ ui.metric('Hydration active time', metrics.hydration is null ? null : metrics.hydration.timeMs|number_format(2), 'ms', 'clock', profileLink ~ '&modernorm_tab=hydration') }}
        </div>
        <nav class="morm-tabs" aria-label="ModernORM sections">
            {% for key, title in tabs %}<a href="{{ path('_profiler', {token: token, panel: 'modernorm', modernorm_tab: key}) }}" {% if active == key %}aria-current="page"{% endif %}>{{ title }}{% if key == 'queries' %} ({{ metrics.sql.count }}){% endif %}</a>{% endfor %}
        </nav>
        {% if collector.dropped %}<div class="morm-notice">{{ collector.dropped }} events omitted from the retained history. Aggregate counters remain complete; event tables and observed maxima are partial.</div>{% endif %}
        <section aria-label="{{ tabs[active] }}">{{ include('@ModernORM/Collector/tabs/' ~ active ~ '.html.twig') }}</section>
        {{ include('@ModernORM/Collector/_advisor.html.twig') }}
        <p class="morm-note">SQL, flush, batch, hydration and UnitOfWork scopes overlap. Do not add their times. Error counts may describe the same failure at different layers. Observer errors: {{ metrics.observerErrors }}.</p>
    </div>
{% endblock %}
