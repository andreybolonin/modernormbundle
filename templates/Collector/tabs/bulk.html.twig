{% import '@ModernORM/Collector/_macros.html.twig' as ui %}
<h3>Bulk Operations</h3>
{% if metrics.bulk is null %}{{ ui.unavailable('Bulk operations') }}{% else %}
    {% set bulk = metrics.bulk %}
    <div class="morm-metrics morm-five">{{ ui.metric('Bulk attempts', bulk.count, '', 'activity') }}{{ ui.metric('Known affected rows', bulk.affectedRows, '', 'rows') }}{{ ui.metric('Input rows', bulk.inputRows, '', 'rows') }}{{ ui.metric('Bulk time', bulk.timeMs|number_format(3), 'ms', 'clock') }}{{ ui.metric('Errors', bulk.errors, '', 'alert') }}</div>
    <div class="morm-box"><h4>Bulk calls · retained events</h4><div class="morm-table"><table><thead><tr><th>Operation</th><th>Entity</th><th>Policy</th><th class="morm-num">Input / affected / returned</th><th class="morm-num">Time (ms)</th><th>Database outcome</th><th>Result</th></tr></thead><tbody>
        {% for event in collector.eventRows('bulk') %}{% if event.bulk %}{% set call = event.bulk %}<tr><td><span class="morm-badge">{{ call.operation|upper }}</span></td><td class="morm-monospace">{{ call.entityClass }}</td><td>{{ call.policy }}</td><td class="morm-num">{{ call.inputRows }} / {{ call.affectedRows ?? 'unknown' }} / {{ call.returnedRows ?? 'unknown' }}</td><td class="morm-num">{{ event.timeMs|number_format(3) }}</td><td>{{ call.databaseCommitted is same as(true) ? 'Committed' : (call.databaseCommitted is same as(false) ? 'Caller transaction pending' : 'Not established') }}</td><td>{{ ui.outcome(event.failed) }}</td></tr>{% endif %}{% else %}<tr><td colspan="7">No bulk events retained. Aggregate bulk counts remain available above.</td></tr>{% endfor %}
    </tbody></table></div><p class="morm-note">Unknown affected rows are not zero. A failure may occur after commit; inspect the recorded outcome before retrying SQL. CLEAR detaches the persistence context; BYPASS retains managed state.</p></div>
    <div class="morm-box"><h4>Measurement scope</h4><p>Bulk time includes validation, SQL preparation, execution, transaction handling, invalidation and CLEAR. Ordinary per-entity flush writes are shown under UnitOfWork.</p><p class="morm-note">Returned row values, predicates and identifiers are not retained here. COPY and StatelessSession are not implemented.</p></div>
{% endif %}
