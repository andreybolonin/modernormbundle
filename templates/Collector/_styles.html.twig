.morm-profiler{color:var(--color-text);font-variant-numeric:tabular-nums}
.morm-profiler svg{width:24px;height:24px;flex-shrink:0}
.morm-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:8px 0 22px;flex-wrap:wrap}
.morm-heading h2{display:flex;align-items:center;gap:12px;border:0;margin:0 0 5px;font-size:25px}.morm-heading p{margin:0;color:var(--color-muted)}
.morm-meta{display:flex;gap:8px;align-items:center}.morm-badge{display:inline-block;border-radius:3px;padding:3px 7px;font-size:12px;background:var(--badge-background);color:var(--badge-color);white-space:nowrap}
.morm-success{background:var(--badge-success-background);color:var(--badge-success-color)}.morm-danger{background:var(--badge-danger-background);color:var(--badge-danger-color)}.morm-warning{background:var(--badge-warning-background);color:var(--badge-warning-color)}
.morm-metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin:16px 0 22px}
.morm-metrics.morm-four{grid-template-columns:repeat(4,minmax(0,1fr))}.morm-metrics.morm-five{grid-template-columns:repeat(5,minmax(0,1fr))}
.morm-metric{display:flex;gap:11px;align-items:center;padding:15px 13px;border:1px solid var(--metric-border-color);border-radius:5px;background:var(--metric-value-background);color:var(--color-text);min-width:0;text-decoration:none}
a.morm-metric:hover{border-color:var(--color-link);text-decoration:none}.morm-metric-icon{color:var(--menu-icon-color)}.morm-metric strong{display:block;font-size:21px;line-height:1.2;font-weight:600}.morm-metric strong small{font-size:12px;color:var(--metric-unit-color)}.morm-metric-label{display:block;font-size:12px;color:var(--color-muted);margin-top:5px;line-height:1.4}
.morm-tabs{display:flex;gap:2px;border-bottom:1px solid var(--tab-border-color);margin:0 0 24px;overflow-x:auto;padding:0 0 1px}
.morm-tabs a{padding:12px 13px;white-space:nowrap;color:var(--tab-color);text-decoration:none;border-bottom:3px solid transparent}.morm-tabs a:hover{background:var(--tab-background)}.morm-tabs a[aria-current=page]{border-bottom-color:var(--menu-active-marker-background);color:var(--menu-active-color);font-weight:600;background:var(--tab-active-background)}
.morm-profiler a:focus-visible,.morm-profiler input:focus-visible,.morm-profiler select:focus-visible{outline:2px solid var(--color-link);outline-offset:3px}
.morm-section-title{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.morm-section-title h3{margin:0}.morm-profiler h3{font-size:19px}.morm-profiler h4{font-size:15px;margin:0 0 12px}
.morm-box{border:1px solid var(--table-border-color);border-radius:5px;padding:18px;margin:16px 0;background:var(--table-background);min-width:0}.morm-box>h3{margin:0 0 14px}.morm-columns{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(240px,1fr);gap:16px}.morm-columns>.morm-box{margin-top:0}
.morm-table{overflow-x:auto}.morm-profiler table{width:100%;margin:12px 0;border-collapse:collapse}.morm-profiler th{white-space:nowrap;font-size:12px}.morm-profiler td,.morm-profiler th{padding:10px 12px;border-color:var(--table-border-color);vertical-align:top}.morm-profiler .morm-num{text-align:right;white-space:nowrap}.morm-profiler pre.morm-sql{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;margin:0;padding:0;background:transparent;border:0;color:inherit;line-height:1.5}.morm-query{min-width:260px}.morm-monospace{font-family:var(--font-family-monospace);font-size:12px;overflow-wrap:anywhere}
.morm-note{font-size:12px;color:var(--color-muted);line-height:1.6;margin:12px 0}.morm-empty{border:1px solid var(--table-border-color);background:var(--table-header);border-radius:4px;padding:20px;margin:16px 0;line-height:1.6}.morm-empty p{margin:6px 0 0;color:var(--color-muted)}.morm-notice{padding:10px 13px;border-left:3px solid var(--color-warning);background:var(--table-header);font-size:12px;line-height:1.5;margin:12px 0}
.morm-filter{display:flex;align-items:end;gap:10px;flex-wrap:wrap}.morm-filter label{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--color-muted)}.morm-filter input,.morm-filter select{background:var(--page-background);color:var(--color-text);border:1px solid var(--form-input-border-color);padding:8px;border-radius:3px}.morm-filter input{width:240px;max-width:100%}.morm-profiler .morm-button{display:inline-block;padding:8px 11px;border:1px solid var(--button-border-color);background:var(--button-background);color:var(--button-color);border-radius:3px;text-decoration:none;white-space:nowrap;font:inherit;font-size:12px;cursor:pointer}
.morm-advisor-title{display:flex;gap:10px;align-items:center}.morm-advisor-title svg{color:var(--menu-icon-color)}.morm-finding{display:grid;grid-template-columns:28px minmax(0,1fr) minmax(0,1fr) auto;gap:13px;padding:18px 0;border-top:1px solid var(--table-border-color);align-items:start}.morm-finding:first-of-type{margin-top:15px}.morm-finding strong{display:block;margin-bottom:6px}.morm-finding p{margin:0;color:var(--color-muted);font-size:12px;line-height:1.65}.morm-severity-warning{color:var(--color-warning)}.morm-severity-error{color:var(--color-error)}.morm-severity-info{color:var(--color-link)}
.morm-dl{display:grid;grid-template-columns:minmax(0,1fr) auto;margin:0;gap:0;font-size:13px}.morm-dl dt,.morm-dl dd{margin:0;padding:11px 0;border-bottom:1px solid var(--table-border-color)}.morm-dl dd{text-align:right;font-weight:600}.morm-dl dt{padding-right:12px;color:var(--color-muted)}
.morm-bar{height:7px;border-radius:4px;background:var(--badge-background);overflow:hidden;margin:14px 0}.morm-bar span{height:100%;display:block;background:var(--color-success)}.morm-profiler tr:target{outline:2px solid var(--color-link);outline-offset:-2px}.morm-summary-links{display:flex;gap:16px;flex-wrap:wrap;font-size:12px}
@media(max-width:1400px){.morm-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.morm-metrics.morm-five{grid-template-columns:repeat(3,minmax(0,1fr))}.morm-finding{grid-template-columns:25px minmax(0,1fr) minmax(0,1fr)}.morm-finding>a{grid-column:2/-1;justify-self:start}}
@media(max-width:950px){.morm-columns{grid-template-columns:1fr}.morm-metrics.morm-four{grid-template-columns:repeat(2,minmax(0,1fr))}.morm-finding{grid-template-columns:24px minmax(0,1fr)}.morm-finding>div:nth-of-type(2){grid-column:2}.morm-metric{padding:12px 9px;gap:8px}.morm-metric strong{font-size:18px}}
@media(max-width:600px){.morm-metrics,.morm-metrics.morm-five{grid-template-columns:repeat(2,minmax(0,1fr))}.morm-tabs a{padding:10px}.morm-filter input{width:180px}.morm-heading h2{font-size:22px}.morm-metric svg{width:19px;height:19px}}

.morm-progress{display:block;appearance:none;width:100%;height:7px;margin:14px 0;border:0;border-radius:4px;background:var(--badge-background);color:var(--color-success)}.morm-progress::-webkit-progress-bar{background:var(--badge-background);border-radius:4px}.morm-progress::-webkit-progress-value{background:var(--color-success);border-radius:4px}.morm-progress::-moz-progress-bar{background:var(--color-success);border-radius:4px}
